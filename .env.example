# Supabase project (Dashboard > Project Settings)
SUPABASE_PROJECT_REF="your-project-ref"
SUPABASE_ACCESS_TOKEN=""          # from https://supabase.com/dashboard/account/tokens (for the CLI)

# Postgres connection strings (Dashboard > Connect). Used by Prisma for db pull and the seed.
# Pooled (port 6543, transaction mode):
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct / session (port 5432):
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
