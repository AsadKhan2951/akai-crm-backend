generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Portal {
  ADMIN
  SALES
  VENDOR
}

enum DataScope {
  GLOBAL
  TEAM
  OWN
  SELF
}

enum ProfileStatus {
  ACTIVE
  SUSPENDED
}

enum CustomerType {
  AUTO_PARTS
  OIL_CHANGE
  CAR_WASH
  DETAILING
  PAINT_HARDWARE
  FUEL_STATION
  DISTRIBUTOR
  OTHER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  PROSPECT
  BLOCKED
}

enum PriceListStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  SUPERSEDED
}

enum PriceListApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

enum PaymentMethod {
  BALANCE
  CREDIT
}

enum PriceAnnouncementStatus {
  DRAFT
  READY
  QUEUED
  SENT
}

enum VisibilityScopeType {
  GROUP
  VENDOR
}

enum VisibilityEntityType {
  CATEGORY
  BRAND
  PRODUCT
}

enum VisibilityMode {
  ALLOW
  DENY
}

enum BannerLinkType {
  PRODUCT
  CATEGORY
  BRAND
  COLLECTION
  EXTERNAL_URL
  NONE
}

enum BannerCtaType {
  BUY_NOW
  REQUEST_QUOTE
  VIEW
}

enum BannerAudienceType {
  ALL
  GROUP
  SPECIFIC_VENDORS
}

enum SchemeType {
  QUANTITY_FREE
  SLAB_DISCOUNT
  BUNDLE
  CATEGORY_TARGET
  FLAT_DISCOUNT
}

enum SchemeScopeType {
  PRODUCT
  CATEGORY
  BRAND
  COLLECTION
  ORDER_VALUE
}

enum SchemeAudienceType {
  ALL
  GROUP
  SPECIFIC_VENDORS
}

enum SchemeBenefitType {
  FREE_ITEM
  DISCOUNT_PERCENT
  DISCOUNT_AMOUNT
}

enum BannerEventType {
  IMPRESSION
  CLICK
}

enum PlacedVia {
  VENDOR_PORTAL
  SALES_AGENT
  ADMIN
  WHATSAPP
  QUOTE_CONVERSION
}

enum OrderStatus {
  DRAFT
  PENDING_APPROVAL
  PLACED
  CONFIRMED
  PICKED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum DeliveryRunStatus {
  PLANNED
  LOADED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum DeliveryStopStatus {
  PENDING
  DELIVERED
  PARTIAL
  FAILED
  RESCHEDULED
}

enum PickingListStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum QuoteStatus {
  REQUESTED
  IN_REVIEW
  QUOTED
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum LeadSource {
  FIELD_VISIT
  REFERRAL
  PHONE_IN
  WALK_IN
  CAMPAIGN
  IMPORT
  OTHER
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum ActivityType {
  CALL
  WHATSAPP
  EMAIL
  VISIT
  NOTE
  MEETING
}

enum ActivityDisposition {
  CONNECTED
  NO_ANSWER
  BUSY
  WRONG_NUMBER
  CALLBACK_REQUESTED
  NOT_INTERESTED
  INTERESTED
  ORDER_PLACED
  QUOTE_REQUESTED
  FOLLOW_UP_SCHEDULED
  COMPLAINT
  PAYMENT_COLLECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum LedgerEntryType {
  INVOICE
  PAYMENT
  CREDIT_NOTE
  ADJUSTMENT
}

enum RewardType {
  DISCOUNT_AMOUNT
  DISCOUNT_PERCENT
  FREE_PRODUCT
  GIFT
}

enum RedemptionStatus {
  REQUESTED
  APPROVED
  FULFILLED
  REJECTED
}

enum MessageChannel {
  WHATSAPP
  EMAIL
  SMS
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  RECEIVED
  SENT
  DELIVERED
  READ
  FAILED
}

enum WhatsappSessionState {
  IDLE
  BROWSING
  BUILDING_CART
  CONFIRMING
  AWAITING_HUMAN
}

enum AiSurface {
  WIDGET
  CATALOG_SEARCH
  COMPOSE
  ANALYTICS
}

enum AiMessageRole {
  user
  assistant
}

enum CollectionMethod {
  CASH
  CHEQUE
  BANK_TRANSFER
  ONLINE
}

enum CollectionStatus {
  COLLECTED
  DEPOSITED
  CLEARED
  BOUNCED
  CANCELLED
}

enum CashDepositStatus {
  PENDING
  VERIFIED
  DISPUTED
}

enum RecoveryReminderStatus {
  DRAFT
  QUEUED
  SENT
  FAILED
  CANCELLED
}

enum ClaimType {
  DAMAGED
  SHORT_SUPPLY
  WRONG_ITEM
  EXPIRED
  WARRANTY
  QUALITY
}

enum ClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESOLVED
}

enum ClaimResolutionType {
  REPLACEMENT
  CREDIT_NOTE
  REFUND
  REPAIR
  NO_ACTION
}

enum BeatVisitStatus {
  PLANNED
  VISITED
  SKIPPED
  RESCHEDULED
}

enum VoiceProcessingStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

model Profile {
  id                String             @id
  displayName       String?            @map("display_name")
  phone             String?
  preferredLocale   String             @default("en") @map("preferred_locale")
  status            ProfileStatus      @default(ACTIVE)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  portalMemberships PortalMembership[]
  userRoles         UserRole[]

  @@map("profiles")
}

model PortalMembership {
  id         String   @id @default(cuid())
  profileId  String   @map("profile_id")
  portal     Portal
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  profile    Profile  @relation(fields: [profileId], references: [id])

  @@unique([profileId, portal])
  @@index([profileId, isActive])
  @@map("portal_memberships")
}

model User {
  id                String       @id
  email             String       @unique
  fullName          String       @map("full_name")
  phone             String?
  roleId            String       @map("role_id")
  managerId         String?      @map("manager_id")
  isActive          Boolean      @default(true) @map("is_active")
  preferredLocale   String       @default("en") @map("preferred_locale")
  permissionVersion Int          @default(1) @map("permission_version")
  lastLoginAt       DateTime?    @map("last_login_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  role              Role         @relation("UserRole", fields: [roleId], references: [id])
  manager           User?        @relation("UserManager", fields: [managerId], references: [id])
  reports           User[]       @relation("UserManager")
  salesAgent        SalesAgent?
  vendorAccount     VendorAccount?
  createdRoles      Role[]       @relation("RoleCreatedBy")
  auditEvents       AuditLog[]   @relation("AuditUser")
  customerLinks     CustomerUser[]
  aiConversations   AiConversation[]
  aiUsage           AiUsage[]
  aiRateLimitBuckets AiRateLimitBucket[]
  notifications     Notification[]
  leadImportBatches  LeadImportBatch[]
  adminReportDefinitions AdminReportDefinition[] @relation("AdminReportCreator")
  adminImpersonationStarted AdminImpersonationSession[] @relation("AdminImpersonationAdmin")
  adminImpersonationTargets AdminImpersonationSession[] @relation("AdminImpersonationTargetUser")
  acknowledgedAnomalies AdminAnomalyAlert[] @relation("AnomalyAcknowledgedBy")
  dashboardCaches AdminDashboardCache[]
  createdAdminUserInvites AdminUserInvite[] @relation("AdminInviteCreator")
  managedAdminUserInvites AdminUserInvite[] @relation("AdminInviteManager")
  createdPaymentCollections PaymentCollection[] @relation("CollectionCreator")
  createdCashDeposits CashDeposit[] @relation("CashDepositCreator")
  verifiedCashDeposits CashDeposit[] @relation("CashDepositVerifier")
  createdRecoveryReminders RecoveryReminderQueue[] @relation("ReminderCreator")
  updatedReminderPreferences CollectionReminderPreference[] @relation("ReminderPreferenceUpdater")
  pushSubscriptions WebPushSubscription[]
  createdSchemes Scheme[] @relation("SchemeCreator")
  deliveryRunsAsDriver DeliveryRun[] @relation("DeliveryDriver")
  createdDeliveryRuns DeliveryRun[] @relation("DeliveryRunCreator")
  createdPickingLists PickingList[]
  raisedClaims Claim[] @relation("ClaimRaisedBy")
  reviewedClaims Claim[] @relation("ClaimReviewedBy")
  registeredWarranties WarrantyRegistration[]
  uploadedClaimPhotos ClaimPhoto[]
  whatsappSessions WhatsappSession[] @relation("WhatsappSessionHandedOff")
  voiceNotes VoiceNote[]

  @@index([roleId, isActive])
  @@index([managerId, isActive])
  @@map("users")
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  dataScope       DataScope        @default(GLOBAL) @map("data_scope")
  portalAccess    Portal           @default(ADMIN) @map("portal_access")
  isSystemRole    Boolean          @default(false) @map("is_system_role")
  isActive        Boolean          @default(true) @map("is_active")
  createdByUserId String?          @map("created_by_user_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  createdByUser   User?            @relation("RoleCreatedBy", fields: [createdByUserId], references: [id])
  users           User[]           @relation("UserRole")
  permissions     RolePermission[]
  userRoles       UserRole[]
  adminUserInvites AdminUserInvite[]

  @@index([isActive, portalAccess])
  @@index([dataScope])
  @@map("roles")
}

model Permission {
  id               String                 @id @default(cuid())
  key              String                 @unique
  module           String
  labelEn          String                 @map("label_en")
  labelUr          String                 @map("label_ur")
  description      String?
  isSensitive      Boolean                @default(false) @map("is_sensitive")
  displayOrder     Int                    @default(0) @map("display_order")
  createdAt        DateTime               @default(now()) @map("created_at")
  roleLinks        RolePermission[]
  dependencies     PermissionDependency[] @relation("DependentPermission")
  prerequisites    PermissionDependency[] @relation("PrerequisitePermission")

  @@index([module, displayOrder])
  @@map("permissions")
}

model PermissionDependency {
  permissionId        String     @map("permission_id")
  requiresPermissionId String     @map("requires_permission_id")
  permission          Permission @relation("DependentPermission", fields: [permissionId], references: [id])
  requiresPermission  Permission @relation("PrerequisitePermission", fields: [requiresPermissionId], references: [id])

  @@id([permissionId, requiresPermissionId])
  @@index([requiresPermissionId])
  @@map("permission_dependencies")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  profileId  String   @map("profile_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  profile    Profile  @relation(fields: [profileId], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])

  @@id([profileId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model SalesAgent {
  id               String       @id @default(uuid())
  userId           String       @unique @map("user_id")
  agentCode        String       @unique @map("agent_code")
  territory        String
  monthlyTargetPKR Decimal      @map("monthly_target_pkr")
  joinedAt         DateTime     @map("joined_at")
  user             User         @relation(fields: [userId], references: [id])
  customers        Customer[]
  leadImportBatches LeadImportBatch[]
  calendarFeedTokens CalendarFeedToken[]
  paymentCollections PaymentCollection[]
  cashDeposits CashDeposit[]
  recoveryTargets RecoveryTarget[]
  recoveryReminders RecoveryReminderQueue[]
  claims Claim[]
  beats Beat[]
  beatVisits BeatVisit[]

  @@index([territory])
  @@map("sales_agents")
}

model AuditLog {
  id          String    @id @default(cuid())
  userId      String?   @map("user_id")
  action      String
  entityType  String    @map("entity_type")
  entityId    String    @map("entity_id")
  changesJson Json?     @map("changes_json")
  ipAddress   String?   @map("ip_address")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User?     @relation("AuditUser", fields: [userId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model StorageObject {
  id           String   @id @default(cuid())
  bucket       String
  objectPath   String   @map("object_path")
  contentType  String   @map("content_type")
  sizeBytes    Int      @map("size_bytes")
  uploadedBy   String   @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([bucket, objectPath])
  @@index([uploadedBy, createdAt])
  @@map("storage_objects")
}

model AreaCode {
  id        String   @id @default(uuid())
  code      String   @unique
  fullNameEn String  @map("full_name_en")
  fullNameUr String  @map("full_name_ur")
  town      String
  latitude  Decimal?
  longitude Decimal?
  customers Customer[]

  @@index([town])
  @@map("area_codes")
}

model VendorGroup {
  id              String    @id @default(uuid())
  name            String    @unique
  description     String?
  isDefault       Boolean   @default(false) @map("is_default")
  showAllByDefault Boolean  @default(false) @map("show_all_by_default")
  priceMultiplier Decimal   @default(1.0) @map("price_multiplier")
  createdAt       DateTime  @default(now()) @map("created_at")
  customers       Customer[]
  bannerAudiences PromoBannerAudience[]
  schemeAudiences SchemeAudience[]
  beatFrequencyTargets BeatFrequencyTarget[]

  @@index([isDefault])
  @@map("vendor_groups")
}

model Customer {
  id                    String         @id @default(uuid())
  legacyName            String         @map("name")
  businessName          String         @map("business_name")
  businessNameUrdu      String?        @map("business_name_urdu")
  areaCode              String         @map("area_code")
  normalizedName        String         @map("normalized_name")
  fullAddress           String?        @map("full_address")
  latitude              Decimal?
  longitude             Decimal?
  contactPersonName     String?        @map("contact_person_name")
  primaryPhone          String?        @map("primary_phone")
  whatsappPhone         String?        @map("whatsapp_phone")
  email                 String?
  customerType          CustomerType   @map("customer_type")
  customerTypeSuggestion CustomerType? @map("customer_type_suggestion")
  duplicateReviewRequired Boolean      @default(false) @map("duplicate_review_required")
  duplicateReviewReason String?        @map("duplicate_review_reason")
  importBatchId         String?        @map("import_batch_id")
  importSourceRow       Int?           @map("import_source_row")
  importKey             String         @unique @map("import_key")
  importedAt            DateTime?      @map("imported_at")
  assignedAgentId       String?        @map("assigned_agent_id")
  vendorGroupId         String?        @map("vendor_group_id")
  creditLimitPKR        Decimal        @map("credit_limit_pkr")
  currentBalancePKR     Decimal        @map("current_balance_pkr")
  loyaltyPointsBalance  Int            @default(0) @map("loyalty_points_balance")
  status                CustomerStatus @default(PROSPECT)
  dataComplete          Boolean        @default(false) @map("data_complete")
  isInternalAccount     Boolean        @default(false) @map("is_internal_account")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  assignedAgent         SalesAgent?    @relation(fields: [assignedAgentId], references: [id])
  area                  AreaCode       @relation(fields: [areaCode], references: [code])
  vendorGroup           VendorGroup?   @relation(fields: [vendorGroupId], references: [id])
  vendorAccount         VendorAccount?
  userLinks             CustomerUser[]
  bannerAudiences       PromoBannerAudience[]
  bannerEvents          BannerEvent[]
  schemeAudiences       SchemeAudience[]
  schemeApplications    SchemeApplication[]
  adminImpersonationTargetCustomers AdminImpersonationSession[] @relation("AdminImpersonationTargetCustomer")
  paymentCollections PaymentCollection[]
  collectionReminderPreference CollectionReminderPreference?
  recoveryReminders RecoveryReminderQueue[]
  creditRiskSnapshots CreditRiskSnapshot[]
  deliveryStops DeliveryStop[]
  claims Claim[]
  warrantyRegistrations WarrantyRegistration[]
  beatCustomers BeatCustomer[]
  beatVisits BeatVisit[]
  whatsappSessions WhatsappSession[] @relation("WhatsappCustomerSession")
  voiceNotes VoiceNote[]

  @@index([assignedAgentId, status])
  @@index([vendorGroupId, status])
  @@index([areaCode])
  @@index([normalizedName])
  @@index([assignedAgentId, dataComplete, areaCode])
  @@index([customerType, status])
  @@index([businessName])
  @@map("customers")
}

model CustomerUser {
  userId      String   @map("user_id")
  customerId  String   @map("customer_id")
  user        User     @relation(fields: [userId], references: [id])
  customer    Customer @relation(fields: [customerId], references: [id])

  @@id([userId, customerId])
  @@index([customerId])
  @@map("customer_users")
}

model VendorAccount {
  id              String   @id @default(uuid())
  customerId      String   @unique @map("customer_id")
  userId          String   @unique @map("user_id")
  canPlaceOrders  Boolean  @default(true) @map("can_place_orders")
  canRequestQuotes Boolean @default(true) @map("can_request_quotes")
  customer        Customer @relation(fields: [customerId], references: [id])
  user            User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("vendor_accounts")
}

model Brand {
  id           String   @id @default(uuid())
  nameEn       String   @map("name_en")
  nameUr       String   @map("name_ur")
  slug         String   @unique
  logoUrl      String?  @map("logo_url")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  notes        String?

  @@index([isActive, displayOrder])
  @@map("brands")
}

model Category {
  id               String    @id @default(uuid())
  nameEn           String    @map("name_en")
  nameUr           String    @map("name_ur")
  slug             String    @unique
  imageUrl         String?   @map("image_url")
  displayOrder     Int       @default(0) @map("display_order")
  isActive         Boolean   @default(true) @map("is_active")
  parentCategoryId  String?   @map("parent_category_id")
  description      String?
  notes            String?
  parentCategory   Category? @relation("CategoryParent", fields: [parentCategoryId], references: [id])
  children         Category[] @relation("CategoryParent")

  @@index([isActive, displayOrder])
  @@index([parentCategoryId])
  @@map("categories")
}

model Collection {
  id           String    @id @default(uuid())
  nameEn       String    @map("name_en")
  nameUr       String    @map("name_ur")
  slug         String    @unique
  imageUrl     String?   @map("image_url")
  description  String?
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  startsAt     DateTime? @map("starts_at")
  endsAt       DateTime? @map("ends_at")

  @@index([isActive, displayOrder])
  @@index([startsAt, endsAt])
  @@map("collections")
}

model Product {
  id                  String          @id @default(uuid())
  sku                 String          @unique
  nameEn              String          @map("name_en")
  nameUr              String          @map("name_ur")
  descriptionEn       String?         @map("description_en")
  descriptionUr       String?         @map("description_ur")
  categoryId          String          @map("category_id")
  brandId             String?         @map("brand_id")
  unitOfMeasure       String          @map("unit_of_measure")
  packSize            Decimal?        @map("pack_size")
  pricePKR            Decimal         @map("price_pkr")
  compareAtPricePKR   Decimal?        @map("compare_at_price_pkr")
  loyaltyPointsPerUnit Int            @default(0) @map("loyalty_points_per_unit")
  warrantyMonths      Int?            @map("warranty_months")
  stockQuantity       Decimal         @map("stock_quantity")
  lowStockThreshold   Decimal         @map("low_stock_threshold")
  isActive            Boolean         @default(true) @map("is_active")
  isQuoteOnly         Boolean         @default(false) @map("is_quote_only")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  cost                ProductCost?
  freeSchemeTiers     SchemeTier[] @relation("SchemeFreeProduct")
  schemeApplicationFreeProducts SchemeApplication[] @relation("SchemeApplicationFreeProduct")
  pickingListLines PickingListLine[]
  claimLines ClaimLine[]
  warrantyRegistrations WarrantyRegistration[]

  @@index([categoryId, isActive])
  @@index([brandId, isActive])
  @@index([isActive, nameEn])
  @@index([stockQuantity, lowStockThreshold])
  @@map("products")
}

model ProductCost {
  productId String  @id @map("product_id")
  costPKR   Decimal @map("cost_pkr")
  product   Product  @relation(fields: [productId], references: [id])

  @@map("product_costs")
}

model ProductImage {
  id           String  @id @default(uuid())
  productId    String  @map("product_id")
  url          String
  altTextEn    String? @map("alt_text_en")
  altTextUr    String? @map("alt_text_ur")
  displayOrder Int     @default(0) @map("display_order")
  isPrimary    Boolean @default(false) @map("is_primary")

  @@index([productId, displayOrder])
  @@map("product_images")
}

model ProductCollection {
  productId    String @map("product_id")
  collectionId String @map("collection_id")
  displayOrder Int    @default(0) @map("display_order")

  @@id([productId, collectionId])
  @@index([collectionId, displayOrder])
  @@map("product_collections")
}

model PriceList {
  id                String          @id @default(uuid())
  name              String
  effectiveFrom     DateTime        @map("effective_from")
  effectiveTo       DateTime?       @map("effective_to")
  status            PriceListStatus
  basedOnPriceListId String?        @map("based_on_price_list_id")
  notes             String?
  createdByUserId   String          @map("created_by_user_id")
  approvalRequired  Boolean         @default(true) @map("approval_required")
  approvalStatus    PriceListApprovalStatus @default(PENDING) @map("approval_status")
  approvedByUserId  String?         @map("approved_by_user_id")
  approvedAt        DateTime?       @map("approved_at")
  rejectionReason   String?         @map("rejection_reason")
  activatedAt       DateTime?       @map("activated_at")
  cataloguePdfUrl   String?         @map("catalogue_pdf_url")
  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([status, effectiveFrom])
  @@index([basedOnPriceListId])
  @@map("price_lists")
}

model PriceListItem {
  id                String   @id @default(uuid())
  priceListId       String   @map("price_list_id")
  productId         String   @map("product_id")
  pricePKR          Decimal  @map("price_pkr")
  compareAtPricePKR Decimal? @map("compare_at_price_pkr")
  cost              PriceListItemCost?

  @@unique([priceListId, productId])
  @@index([productId])
  @@map("price_list_items")
}

model PriceListItemCost {
  priceListItemId String        @id @map("price_list_item_id")
  costPKR         Decimal       @map("cost_pkr")
  priceListItem   PriceListItem @relation(fields: [priceListItemId], references: [id])

  @@map("price_list_item_costs")
}

model CatalogVisibilityRule {
  id              String               @id @default(uuid())
  scopeType       VisibilityScopeType  @map("scope_type")
  scopeId         String               @map("scope_id")
  entityType      VisibilityEntityType @map("entity_type")
  entityId        String               @map("entity_id")
  mode            VisibilityMode
  createdAt       DateTime             @default(now()) @map("created_at")
  createdByUserId String               @map("created_by_user_id")

  @@index([scopeType, scopeId, entityType, entityId])
  @@index([entityType, entityId, mode])
  @@map("catalog_visibility_rules")
}

model PromoBanner {
  id              String              @id @default(uuid())
  titleEn         String              @map("title_en")
  titleUr         String              @map("title_ur")
  subtitleEn      String?             @map("subtitle_en")
  subtitleUr      String?             @map("subtitle_ur")
