  uploadedByUser    User?    @relation(fields: [uploadedByUserId], references: [id])

  @@index([claimId, uploadedAt])
  @@map("claim_photos")
}

model WarrantyRegistration {
  id                       String   @id @default(uuid())
  productId                String   @map("product_id")
  serialNumber             String   @unique @map("serial_number")
  customerId               String   @map("customer_id")
  endCustomerName          String?  @map("end_customer_name")
  endCustomerPhone         String?  @map("end_customer_phone")
  soldAt                   DateTime @map("sold_at")
  warrantyMonths           Int      @map("warranty_months")
  expiresAt                DateTime @map("expires_at")
  registeredByUserId       String   @map("registered_by_user_id")
  consentForConsumerContact Boolean @default(false) @map("consent_for_consumer_contact")
  createdAt                DateTime @default(now()) @map("created_at")
  product                  Product  @relation(fields: [productId], references: [id])
  customer                 Customer @relation(fields: [customerId], references: [id])
  registeredByUser         User     @relation(fields: [registeredByUserId], references: [id])

  @@index([customerId, expiresAt])
  @@index([productId, serialNumber])
  @@index([expiresAt])
  @@map("warranty_registrations")
}


model WhatsappSession {
  id                String                @id @default(uuid())
  phone             String                @unique
  customerId        String?               @map("customer_id")
  state             WhatsappSessionState  @default(IDLE)
  cartJson          Json?                 @map("cart_json")
  lastMessageAt     DateTime              @map("last_message_at")
  expiresAt         DateTime              @map("expires_at")
  handedOffToUserId String?               @map("handed_off_to_user_id")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  customer          Customer?             @relation("WhatsappCustomerSession", fields: [customerId], references: [id])
  handedOffToUser   User?                 @relation("WhatsappSessionHandedOff", fields: [handedOffToUserId], references: [id])

  @@index([customerId, state, lastMessageAt])
  @@index([state, expiresAt])
  @@map("whatsapp_sessions")
}


model VoiceNote {
  id                   String                @id @default(uuid())
  userId               String                @map("user_id")
  activityId           String?               @map("activity_id")
  claimId              String?               @map("claim_id")
  customerId           String?               @map("customer_id")
  audioUrl             String                @map("audio_url")
  durationSeconds      Int                   @map("duration_seconds")
  transcript           String?
  transcriptLanguage   String?               @map("transcript_language")
  structuredOutputJson Json?                 @map("structured_output_json")
  processingStatus     VoiceProcessingStatus @default(PENDING) @map("processing_status")
  processingError      String?               @map("processing_error")
  processedAt          DateTime?             @map("processed_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  user                 User                  @relation(fields: [userId], references: [id])
  activity             Activity?             @relation(fields: [activityId], references: [id])
  claim                Claim?                @relation(fields: [claimId], references: [id])
  customer             Customer?             @relation(fields: [customerId], references: [id])

  @@index([userId, createdAt])
  @@index([customerId, createdAt])
  @@index([activityId])
  @@index([claimId])
  @@index([processingStatus, createdAt])
  @@map("voice_notes")
}
